        "@trumbodev/cli-darwin-x64": "3.9.1",
        "@trumbodev/cli-linux-arm64": "3.9.1",
        "@trumbodev/cli-linux-x64": "3.9.1",
        "@trumbodev/cli-win32-arm64": "3.9.1",
        "@trumbodev/cli-win32-x64": "3.9.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xedro98/Trumbo.git",
        "directory": "projects/trumbo-cli"
