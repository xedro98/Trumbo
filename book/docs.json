{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Trumbo",
	"description": "AI-powered coding agent, Platform products, APIs, and SDK",
	"colors": {
		"primary": "#2BBF77",
		"light": "#E8F8F0",
		"dark": "#000000"
	},
	"logo": {
		"light": "/assets/trumbo-logo.svg",
		"dark": "/assets/trumbo-logo.svg",
		"href": "https://platform.trumbo.dev"
	},
	"favicon": "/assets/trumbo-logo.svg",
