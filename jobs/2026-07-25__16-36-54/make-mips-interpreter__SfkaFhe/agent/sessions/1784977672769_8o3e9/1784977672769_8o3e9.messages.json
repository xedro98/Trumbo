0;\n      break;\n    }\n    default:\n      if ((funct & 0x30) === 0x30) { // C.cond\n        const cc = (instr >>> 8) & 7;\n        const cond = funct & 0xf;\n        let a, b;\n        if (isS) { a = getSingle(fs); b = getSingle(ft); }\n        else if (isD) { a = getDouble(fs); b = getDouble(ft); }\n        else { a = 0; b = 0; }\n        let res = 0;\n        // unordered flag if NaN\n        const unordered = (a !== a) || (b !== b);\n        switch (cond) {\n          case 0x2: res = (a === b) ? 1 : 0; break; // EQ\n          case 0x4: res = (a < b) ? 1 : 0; break; // OLT\n          case 0xc: res = (a < b && !unordered) ? 1 : 0; break; // LT\n          case 0xa: res = (a <= b) ? 1 : 0; break; // OLE\n          case 0xe: res = (a <= b && !unordered) ? 1 : 0; break; // LE\n          case 0x0: res = 0; break; // F (false)\n          case 0x1: res = unordered ? 1 : 0; break; // UN (unordered)\n          case 0x3: res = (a === b || unordered) ? 1 : 0; break; // UEQ\n          case 0xb: res = (a > b || unordered) ? 1 : 0; break; // UGT\n          case 0xd: res = (a >= b || unordered) ? 1 : 0; break; // UGE\n          case 0x5: res = (a < b || unordered) ? 1 : 0; break; // ULT\n          case 0x7: res = (a <= b || unordered) ? 1 : 0; break; // ULE\n          case 0x8: res = (a >= b) ? 1 : 0; break; // SF? actually 0x8 = ? \n          default: res = 0;\n        }\n        if (res) fcc |= (1 << cc); else fcc &= ~(1 << cc);\n      }\n      break;\n  }\n  return null;\n}\n```\n\nWait, there's an issue with CVT.S / CVT.D when the source fmt is single/double and the conversion is to the same type. E.g., cvt.s.w (fmt=0x14 word -> single): handled. cvt.d.s (fmt=0x10 single -> double): handled. Good.\n\nBut I have a concern about cvt.s.w: `setSingle(fd, Math.fround(fprLo[fs] | 0))`. The source word is in fprLo[fs] interpreted as signed int32. `fprLo[fs] | 0` gives signed int32. Math.fround converts to single. setSingle stores it. ✓ (matches disasm: cvt.s.w $f0,$f0 where f0 ho