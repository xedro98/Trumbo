n      else if (isD) setDouble(fd, getDouble(fs) * getDouble(ft));\n      break;\n    }\n    case 0x03: { // DIV\n      if (isS) setSingle(fd, Math.fround(getSingle(fs) / getSingle(ft)));\n      else if (isD) setDouble(fd, getDouble(fs) / getDouble(ft));\n      break;\n    }\n    case 0x04: { // SQRT\n      if (isS) setSingle(fd, Math.fround(Math.sqrt(getSingle(fs))));\n      else if (isD) setDouble(fd, Math.sqrt(getDouble(fs)));\n      break;\n    }\n    case 0x05: { // ABS\n      if (isS) setSingle(fd, Math.fround(Math.abs(getSingle(fs))));\n      else if (isD) setDouble(fd, Math.abs(getDouble(fs)));\n      break;\n    }\n    case 0x06: { // MOV\n      if (isS) setSingle(fd, getSingle(fs));\n      else if (isD) setDouble(fd, getDouble(fs));\n      else { fprLo[fd]=fprLo[fs]; fprHi[fd]=fprHi[fs]; }\n      break;\n    }\n    case 0x07: { // NEG\n      if (isS) setSingle(fd, Math.fround(-getSingle(fs)));\n      else if (isD) setDouble(fd, -getDouble(fs));\n      break;\n    }\n    case 0x0d: { // TRUNC.W\n      // truncate toward zero to int32\n      let v;\n      if (isS) v = Math.trunc(getSingle(fs));\n      else if (isD) v = Math.trunc(getDouble(fs));\n      else if (fmt === 0x14) v = fprLo[fs] | 0; // trunc.w from word? no\n      // store as word in fd (low word)\n      fpI32[0] = v | 0; fprLo[fd] = fpI32[0];\n      break;\n    }\n    case 0x0c: { // ROUND.W (round to nearest, ties to even? MIPS round to nearest)\n      let v;\n      if (isS) v = Math.round(getSingle(fs));\n      else if (isD) v = Math.round(getDouble(fs));\n      fprLo[fd] = v | 0;\n      break;\n    }\n    case 0x0e: { // CEIL.W (round up)\n      let v;\n      if (isS) v = Math.ceil(getSingle(fs));\n      else if (isD) v = Math.ceil(getDouble(fs));\n      fprLo[fd] = v | 0;\n      break;\n    }\n    case 0x0f: { // FLOOR.W (round down)\n      let v;\n      if (isS) v = Math.floor(getSingle(fs));\n      else if (isD) v = Math.floor(getDouble(fs));\n      fprLo[fd] = v | 0;\n      break;\n    }\n